@startuml Architecture

skinparam packageStyle rectangle
allowmixing

package "Proto Definitions" as Proto {
}

package "msensor::SensorsServer" as Server {
    class SensorsServer

    package "Sensor Services" as SSensor {
        class LidarServiceImpl {
            -bus : SensorBus
        }
        class ImuServiceImpl {
            -bus : SensorBus
        }
        class CameraServiceImpl {
            -bus : SensorBus
        }
        class AdcServiceImpl {
            -adc : IAdc
        }
    }

    SensorsServer *-- LidarServiceImpl
    SensorsServer *-- ImuServiceImpl
    SensorsServer *-- CameraServiceImpl
    SensorsServer *-- AdcServiceImpl
}

package "Sensor Bus" as Bus {
    class SensorBus
    class "Topic<T>" as Topic
    class "Subscription<T>" as Subscription
    SensorBus *-- Topic : lidar, imu, camera
    Topic o-- "0..*" Subscription : bounded FIFO each
}

package "Sensor Interfaces" as ISensor {
    interface ILidar
    interface IImu
    interface ICamera
    interface IAdc
}

package "Sensor Drivers" as Sensor {
    class RPLidar
    class Mid360
    class ICM20948
    class OpenCvCamera
    class ADS1115
}

package "Sensor Simulators" as SimSensor {
    class SimLidar
    class SimImu
    class SimCamera
    class SimAdc
}

package "Recording" as Rec {
    class ScanRecorder
    class BusRecorder
    class ScanPlayer
    class RecordingSensorDriver
}

package "Configuration" as Cfg {
    class Config
    class Sensors
    class "makeSensors()" as MakeSensors
}

' Proto generates services
Proto ..> SSensor : generates

' The bus owns the drivers and is their single callback consumer; each gRPC
' client stream is a subscriber (up to max_clients_per_stream per stream)
SensorsServer o-- SensorBus
SensorBus o-- ILidar
SensorBus o-- IImu
SensorBus o-- ICamera
LidarServiceImpl --> Topic : subscribes
ImuServiceImpl --> Topic : subscribes
CameraServiceImpl --> Topic : subscribes

' Services depend on Interfaces (dependency injection)
AdcServiceImpl o-- IAdc

' Force Drivers below Interfaces
ISensor -down[hidden]- Sensor

' Drivers implement Interfaces
RPLidar .up.|> ILidar
Mid360 .up.|> ILidar
Mid360 .up.|> IImu
ICM20948 .up.|> IImu
OpenCvCamera .up.|> ICamera
ADS1115 .up.|> IAdc

' Simulators also implement Interfaces
SimLidar .up.|> ILidar
SimImu .up.|> IImu
SimCamera .up.|> ICamera
SimAdc .up.|> IAdc

' Recording side
RecordingSensorDriver .up.|> ILidar
RecordingSensorDriver .up.|> IImu
RecordingSensorDriver o-- ScanPlayer
BusRecorder o-- SensorBus : subscribes to lidar, imu
BusRecorder *-- ScanRecorder : writer thread
ScanRecorder ..> ILidar : records
ScanRecorder ..> IImu : records

' Remote client consumes the gRPC services as local interfaces
class SensorsRemoteClient
SensorsRemoteClient .up.|> ILidar
SensorsRemoteClient .up.|> IImu
SensorsRemoteClient --> LidarServiceImpl : getLidarScan
SensorsRemoteClient --> ImuServiceImpl : getImuData

' sensor_publisher: Config -> makeSensors() -> Sensors -> SensorsServer
Config --> MakeSensors : read by
MakeSensors ..> Sensors : builds
Sensors o-- ILidar
Sensors o-- IImu
Sensors o-- ICamera
Sensors o-- IAdc
Sensors --> SensorsServer : constructs

component SensorClient
' Other clients call gRPC services
SensorClient --> LidarServiceImpl : getLidarScan
SensorClient --> ImuServiceImpl : getImuData
SensorClient --> CameraServiceImpl : getCameraFrame
SensorClient --> AdcServiceImpl : getAdcData
@enduml
