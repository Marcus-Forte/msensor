// devcontainer for development
{
	"name": "msensor",
	"image": "mdnf1992/cpp-dev",
	
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cmake-tools",
                "ms-vscode.cpp-devtools",
				"llvm-vs-code-extensions.vscode-clangd",
				"ms-python.python",
				"DrBlury.protobuf-vsc"
			],
			 "settings": {
                "clangd.arguments": ["-header-insertion=never"],
                "cmake.useCMakePresets": "always"
            }
		}
	},

	"appPort": ["50051:50051"],

	"mounts": [
		"source=msensor-build-${devcontainerId},target=${containerWorkspaceFolder}/build,type=volume",
		"source=msensor-venv-${devcontainerId},target=${containerWorkspaceFolder}/client/.venv,type=volume",
		"source=opencode-sessions,target=/root/.local/share/opencode,type=volume"
	],
	"runArgs": [
		"--privileged",
		"-v","/dev:/dev",
		"-v","/run/udev:/run/udev:ro"
	]
}
